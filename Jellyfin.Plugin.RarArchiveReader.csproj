<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0 builds against Jellyfin 10.11.x, net10.0 against Jellyfin 12.x.
         Both come from the same source; ship the DLL matching your server. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <AssemblyVersion>3.1.0.0</AssemblyVersion>
    <FileVersion>3.1.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="10.11.4" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned: StoredRarMap reflects into SharpCompress internals (parts,
         FileHeader, SourceStream.Files) for the seekable stored-entry path.
         Verify direct stored access still works before bumping this. -->
    <PackageReference Include="SharpCompress" Version="0.44.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build.yaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html">
      <LogicalName>Jellyfin.Plugin.RarArchiveReader.Configuration.configPage.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
